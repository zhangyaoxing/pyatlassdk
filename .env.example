# Copy to .env and fill in your own values. .env is git-ignored.
# Atlas Administration API (Digest)
MONGO_ATLAS_PUBLIC_KEY=
MONGO_ATLAS_PRIVATE_KEY=

# Atlas Administration API (OAuth 2.0 service account), alternative to Digest
MONGO_ATLAS_CLIENT_ID=
MONGO_ATLAS_CLIENT_SECRET=

# Optional endpoint overrides
MONGO_ATLAS_BASE_URL=https://cloud.mongodb.com/api/atlas/v2
MONGO_ATLAS_OAUTH_TOKEN_URL=https://cloud.mongodb.com/api/oauth/token

# App Services Admin API (bearer token)
MONGO_ATLAS_ACCESS_TOKEN=
MONGO_ATLAS_APP_BASE_URL=https://services.cloud.mongodb.com/api/admin/v3.0

# Atlas Status API
MONGO_ATLAS_STATUS_BASE_URL=https://status.mongodb.com/api/v2

# Defaults used by the Performance Advisor example
MONGO_ATLAS_GROUP_ID=
MONGO_ATLAS_CLUSTER_NAME=
